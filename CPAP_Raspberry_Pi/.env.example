# ============================================================
# CPAP Raspberry Pi Edge Node - Environment Configuration
# ============================================================

# Shared API key between Phone app and Pi (sent as X-API-Key)
API_KEY=your_edge_api_key_here

# Video VM Server base URL and authentication
VIDEO_VM_URL=http://localhost:8080
VIDEO_SERVER_API_KEY=your_video_server_api_key_here

# Scenario 3 GenAI timeout in seconds
GENERATION_TIMEOUT_S=20

# Central Clinical Backend Telemetry API
BACKEND_API_URL=http://localhost:80/api/telemetry
BACKEND_API_KEY=your_backend_api_key_here
TELEMETRY_ENABLED=true

# Root directory for metadata
LIBRARY_ROOT=.
LOG_DIR=logs
EVENT_LOG_DIR=logs/events
INGEST_DATA_DIR=data/ingest
