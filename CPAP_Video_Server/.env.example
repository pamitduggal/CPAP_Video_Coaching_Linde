# ============================================================
# CPAP Video VM Server - Environment Configuration Template
# ============================================================

# Network & Server Settings
HOST=0.0.0.0
PORT=8080
VIDEO_BASE_DIR=C:\CPAP_Video_Server
PUBLIC_BASE_URL=http://localhost:8080
DASHBOARD_BASE_URL=http://localhost:80
DASHBOARD_URL=http://localhost:80

# Security: Server Secret Key for incoming API requests (X-API-KEY header)
SERVER_API_KEY=your_video_server_api_key_here
VIDEO_SERVER_API_KEY=your_video_server_api_key_here

# Security: Outgoing Webhook Key for VM2 Dashboard (X-Video-Server-Key header)
VIDEO_SERVER_KEY=your_video_server_hmac_key_here
X_VIDEO_SERVER_KEY=your_video_server_hmac_key_here

# Security: Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,*

# Google Cloud Vertex AI Configuration for Scenario 3
GOOGLE_VERTEX_API_KEY=your_google_vertex_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=veo-3.1-generate-preview

# Central Backend Telemetry & Distributed Tracing
BACKEND_API_URL=http://localhost:80/api/telemetry
BACKEND_API_KEY=your_backend_api_key_here

# Distributed Multi-Node Trigger Sync Endpoints
AI_SERVER_URL=http://localhost:8001/api/triggers/sync
RPI_EDGE_URL=http://localhost:8000/api/triggers/sync
